rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOfficialMember() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        exists(/databases/$(database)/documents/signupApprovals/$(request.auth.token.email));
    }

    function hasFormalMemberRecord() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/members/$(request.auth.uid)).data.membershipStatus in ["formal_member", "officer", "admin"] ||
          get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status in ["formal_member", "officer", "admin"]
        );
    }

    function classSessionAllowsNonMembers(sessionId) {
      return sessionId is string
        && exists(/databases/$(database)/documents/classSessions/$(sessionId))
        && get(/databases/$(database)/documents/classSessions/$(sessionId)).data.allowNonMembers == true;
    }

    function ownClassSignupPath(sessionId) {
      let signupId = sessionId + "-" + request.auth.uid;
      return /databases/$(database)/documents/classSessionSignups/$(signupId);
    }

    function classStatsPath(sessionId) {
      return /databases/$(database)/documents/classSessionStats/$(sessionId);
    }

    function canJoinClassSession(sessionId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/classSessions/$(sessionId))
        && get(/databases/$(database)/documents/classSessions/$(sessionId)).data.signupRequired == true
        && (isAdmin() || hasFormalMemberRecord() || isOfficialMember() || classSessionAllowsNonMembers(sessionId));
    }

    function classSignupWindowIsOpen(sessionId) {
      let session = get(/databases/$(database)/documents/classSessions/$(sessionId)).data;
      let formalAccess = isAdmin() || hasFormalMemberRecord() || isOfficialMember();
      let openAt = formalAccess
        ? session.get("memberSignupOpenAtTimestamp", null)
        : session.get("publicSignupOpenAtTimestamp", null);
      let closeAt = session.get("signupCloseAtTimestamp", null);
      return openAt is timestamp
        && closeAt is timestamp
        && request.time >= openAt
        && request.time <= closeAt;
    }

    function currentTermSettingsPath() {
      return /databases/$(database)/documents/siteSettings/currentTerm;
    }

    function ownMemberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    function ownClubApplicationPath() {
      return /databases/$(database)/documents/applications/$("club-" + request.auth.uid);
    }

    function membershipStatsPath(year, term) {
      return /databases/$(database)/documents/membershipRegistrationStats/$(year + "-" + term);
    }

    function memberDataIsAdmin(member) {
      let uid = member.get("uid", "");
      return uid is string
        && uid.size() > 0
        && exists(/databases/$(database)/documents/admins/$(uid));
    }

    function occupiesMembershipSlot(member, year, term) {
      return !memberDataIsAdmin(member)
        && member.get("academicYear", "") == year
        && member.get("term", "") == term
        && (
          member.get("membershipStatus", "not_applied") in ["pending_payment", "formal_member"] ||
          member.get("status", "not_applied") in ["pending_payment", "formal_member"]
        );
    }

    function validMembershipPayment(member) {
      let intent = member.get("membershipIntent", "not_join");
      let method = member.get("paymentMethod", "none");
      return intent in ["join", "not_join"]
        && (member.get("membershipStatus", "not_applied") == "membership_waitlisted"
          ? intent == "join"
            && method == "none"
            && member.get("cashPaymentSlot", "") == ""
            && member.get("transferAt", "") == ""
            && member.get("transferLastFive", "") == ""
          : intent == "not_join"
          ? method == "none"
            && member.get("cashPaymentSlot", "") == ""
            && member.get("transferAt", "") == ""
            && member.get("transferLastFive", "") == ""
          : (
            (method == "cash"
              && member.get("cashPaymentSlot", "") is string
              && member.get("cashPaymentSlot", "").size() > 0
              && member.get("cashPaymentSlot", "").size() <= 50
              && member.get("transferAt", "") == ""
              && member.get("transferLastFive", "") == "") ||
            (method == "transfer"
              && member.get("cashPaymentSlot", "") == ""
              && member.get("transferAt", "") is string
              && member.get("transferAt", "").size() > 0
              && member.get("transferAt", "").size() <= 40
              && member.get("transferLastFive", "") is string
              && member.get("transferLastFive", "").matches('^[0-9]{5}$')) ||
            (method == "later"
              && member.get("cashPaymentSlot", "") == ""
              && member.get("transferAt", "") == ""
              && member.get("transferLastFive", "") == "")
          ));
    }

    function validMembershipCounterTransition(beforeMember, afterMember, settings) {
      let year = settings.academicYear;
      let term = settings.term;
      let statsPath = membershipStatsPath(year, term);
      let beforeOccupies = occupiesMembershipSlot(beforeMember, year, term);
      let afterOccupies = occupiesMembershipSlot(afterMember, year, term);
      let oldCount = exists(statsPath) ? get(statsPath).data.count : 0;
      return beforeOccupies == afterOccupies ||
        (afterOccupies
          ? existsAfter(statsPath)
            && getAfter(statsPath).data.count == oldCount + 1
          : (!exists(statsPath) || (oldCount == 0
            ? getAfter(statsPath).data.count == 0
            : (
            existsAfter(statsPath)
            && getAfter(statsPath).data.count == oldCount - 1
          ))));
    }

    function validOwnMembershipUpdate(userId) {
      let settings = get(currentTermSettingsPath()).data;
      let registration = settings.membershipRegistration;
      let beforeOccupies = occupiesMembershipSlot(resource.data, settings.academicYear, settings.term);
      let afterOccupies = occupiesMembershipSlot(request.resource.data, settings.academicYear, settings.term);
      return isSignedIn()
        && request.auth.uid == userId
        && settings.academicYear is string
        && settings.academicYear.matches('^[0-9]{2,3}$')
        && settings.term in ["上學期", "下學期"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "academicYear", "term", "membershipIntent", "membershipStatus", "status",
          "paymentStatus", "paymentMethod", "cashPaymentSlot", "transferAt",
          "transferLastFive", "paymentSubmittedAt", "membershipRegistrationPosition",
          "membershipWaitlistPosition", "membershipWaitlistedAt", "updatedAt"
        ])
        && !(resource.data.get("membershipStatus", "not_applied") in ["formal_member", "officer", "admin"])
        && !(resource.data.get("status", "not_applied") in ["formal_member", "officer", "admin"])
        && resource.data.get("paymentStatus", "unpaid") != "paid"
        && request.resource.data.academicYear == settings.academicYear
        && request.resource.data.term == settings.term
        && request.resource.data.membershipStatus in ["not_applied", "pending_payment", "membership_waitlisted"]
        && request.resource.data.status == request.resource.data.membershipStatus
        && request.resource.data.paymentStatus == "unpaid"
        && request.resource.data.membershipStatus == (request.resource.data.membershipIntent == "join"
          ? (request.resource.data.membershipStatus == "membership_waitlisted" ? "membership_waitlisted" : "pending_payment")
          : "not_applied")
        && validMembershipPayment(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.membershipStatus == "pending_payment"
          ? request.resource.data.paymentSubmittedAt == request.time
          : request.resource.data.paymentSubmittedAt == null)
        && (beforeOccupies || !afterOccupies || (
          registration.limit is int
          && registration.limit > 0
          && registration.openAtTimestamp is timestamp
          && registration.closeAtTimestamp is timestamp
          && request.time >= registration.openAtTimestamp
          && request.time <= registration.closeAtTimestamp
        ))
        && validMembershipCounterTransition(resource.data, request.resource.data, settings)
        && (afterOccupies
          ? existsAfter(ownClubApplicationPath())
            && getAfter(ownClubApplicationPath()).data.updatedAt == request.time
          : !existsAfter(ownClubApplicationPath()));
    }

    function validOwnClubApplicationWrite(applicationId) {
      let settings = get(currentTermSettingsPath()).data;
      let member = getAfter(ownMemberPath()).data;
      return isSignedIn()
        && applicationId == "club-" + request.auth.uid
        && request.resource.data.keys().hasOnly([
          "userId", "name", "studentId", "department", "school", "phone", "email", "note",
          "applicationType", "academicYear", "term", "approved", "reviewStatus", "submittedAt", "updatedAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.applicationType == "club"
        && request.resource.data.academicYear == settings.academicYear
        && request.resource.data.term == settings.term
        && request.resource.data.approved == false
        && request.resource.data.reviewStatus == "pending"
        && request.resource.data.name == member.get("name", member.get("displayName", ""))
        && request.resource.data.studentId == member.get("studentId", "")
        && request.resource.data.department == member.get("department", "")
        && request.resource.data.school == member.get("school", "")
        && request.resource.data.phone == member.get("phone", "")
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.submittedAt is timestamp
        && member.membershipIntent == "join"
        && member.membershipStatus == "pending_payment";
    }

    function validOwnMembershipStatsWrite(periodId) {
      let settings = get(currentTermSettingsPath()).data;
      let statsPath = membershipStatsPath(settings.academicYear, settings.term);
      let beforeMember = get(ownMemberPath()).data;
      let afterMember = getAfter(ownMemberPath()).data;
      let oldCount = exists(statsPath) ? get(statsPath).data.count : 0;
      let oldRegistrationSequence = exists(statsPath) ? get(statsPath).data.get("registrationSequence", oldCount) : 0;
      let oldWaitlistSequence = exists(statsPath) ? get(statsPath).data.get("waitlistSequence", 0) : 0;
      let beforeOccupies = occupiesMembershipSlot(beforeMember, settings.academicYear, settings.term);
      let afterOccupies = occupiesMembershipSlot(afterMember, settings.academicYear, settings.term);
      let joinsWaitlist = beforeMember.get("membershipStatus", "not_applied") != "membership_waitlisted"
        && afterMember.get("membershipStatus", "not_applied") == "membership_waitlisted";
      return isSignedIn()
        && periodId == settings.academicYear + "-" + settings.term
        && (beforeOccupies != afterOccupies || joinsWaitlist)
        && request.resource.data.keys().hasOnly(["academicYear", "term", "count", "limit", "registrationSequence", "waitlistSequence", "updatedAt"])
        && request.resource.data.academicYear == settings.academicYear
        && request.resource.data.term == settings.term
        && request.resource.data.limit == settings.membershipRegistration.limit
        && request.resource.data.count is int
        && request.resource.data.count == oldCount + (beforeOccupies == afterOccupies ? 0 : (afterOccupies ? 1 : -1))
        && request.resource.data.count >= 0
        // An existing over-capacity count can happen after an administrator
        // lowers the limit. Waitlisting a member does not occupy another slot,
        // so it must still be allowed to preserve that unchanged count.
        && (!afterOccupies || request.resource.data.count <= request.resource.data.limit)
        && request.resource.data.registrationSequence == oldRegistrationSequence + (afterOccupies && !beforeOccupies ? 1 : 0)
        && request.resource.data.waitlistSequence == oldWaitlistSequence + (joinsWaitlist ? 1 : 0)
        && (afterOccupies && !beforeOccupies
          ? afterMember.get("membershipRegistrationPosition", 0) == request.resource.data.registrationSequence
          : true)
        && (joinsWaitlist
          ? afterMember.get("membershipWaitlistPosition", 0) == request.resource.data.waitlistSequence
          : true)
        && request.resource.data.updatedAt == request.time;
    }

    function validOwnSignupCreate(sessionId) {
      let session = get(/databases/$(database)/documents/classSessions/$(sessionId)).data;
      let limit = session.get("signupLimit", 30);
      let statsAfter = getAfter(classStatsPath(sessionId)).data;
      let statsBefore = exists(classStatsPath(sessionId)) ? get(classStatsPath(sessionId)).data : {};
      let countBefore = statsBefore.get("signupCount", 0);
      let formalAccess = isAdmin() || hasFormalMemberRecord() || isOfficialMember();
      return canJoinClassSession(sessionId)
        && classSignupWindowIsOpen(sessionId)
        && countBefore < limit
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.sessionId == sessionId
        && request.resource.data.keys().hasOnly([
          "sessionId", "userId", "email", "name", "studentId", "note",
          "membershipStatusAtSignup", "isFormalMemberAtSignup", "dropInPaymentStatus",
          "sessionDate", "sessionWeekday", "sessionTitle", "sessionTimeLabel",
          "timeSlots", "createdAt", "updatedAt"
        ])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.studentId is string && request.resource.data.studentId.size() <= 30
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.timeSlots is list
        && request.resource.data.timeSlots.size() == 2
        && request.resource.data.timeSlots.hasAll(["firstHalf", "secondHalf"])
        && request.resource.data.membershipStatusAtSignup is string
        && request.resource.data.isFormalMemberAtSignup == formalAccess
        && request.resource.data.dropInPaymentStatus == (formalAccess ? "not_required" : "unpaid")
        && (formalAccess
          ? request.resource.data.membershipStatusAtSignup == "formal_member"
          : request.resource.data.membershipStatusAtSignup != "formal_member")
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && statsAfter.signupCount == countBefore + 1
        && statsAfter.firstHalfCount == countBefore + 1
        && statsAfter.secondHalfCount == countBefore + 1;
    }

    function validOwnSignupUpdate(sessionId) {
      let statsBefore = get(classStatsPath(sessionId)).data;
      let statsAfter = getAfter(classStatsPath(sessionId)).data;
      let count = statsBefore.signupCount;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["note", "updatedAt"])
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && statsAfter.signupCount == count
        && statsAfter.firstHalfCount == count
        && statsAfter.secondHalfCount == count
        && request.resource.data.updatedAt == request.time;
    }
    match /admins/{userId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /members/{userId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          "uid", "email", "name", "displayName", "studentId", "department", "school", "phone",
          "academicYear", "term", "applicationType", "membershipIntent", "membershipStatus", "status",
          "paymentStatus", "paymentMethod", "cashPaymentSlot", "transferAt", "transferLastFive",
          "paymentSubmittedAt", "notificationPreferences", "dismissedNotificationIds", "readNotificationIds",
          "privacyConsent", "source", "createdAt", "updatedAt", "lastLoginAt"
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.membershipStatus == "not_applied" &&
        request.resource.data.status == "not_applied" &&
        request.resource.data.paymentStatus == "unpaid" &&
        (!request.resource.data.keys().hasAny(["academicYear"]) || (request.resource.data.academicYear is string && request.resource.data.academicYear.matches('^[0-9]{2,3}$'))) &&
        (!request.resource.data.keys().hasAny(["term"]) || request.resource.data.term in ["上學期", "下學期", "未設定"]) &&
        (!request.resource.data.keys().hasAny(["applicationType"]) || request.resource.data.applicationType in ["club", "class"]) &&
        (!request.resource.data.keys().hasAny(["membershipIntent"]) || request.resource.data.membershipIntent == "not_join") &&
        (!request.resource.data.keys().hasAny(["paymentMethod"]) || request.resource.data.paymentMethod == "none") &&
        (!request.resource.data.keys().hasAny(["cashPaymentSlot"]) || (request.resource.data.cashPaymentSlot is string && request.resource.data.cashPaymentSlot.size() <= 50)) &&
        (!request.resource.data.keys().hasAny(["transferAt"]) || (request.resource.data.transferAt is string && request.resource.data.transferAt.size() <= 40)) &&
        (!request.resource.data.keys().hasAny(["transferLastFive"]) || (request.resource.data.transferLastFive is string && request.resource.data.transferLastFive.size() <= 5)) &&
        (!request.resource.data.keys().hasAny(["source"]) || (request.resource.data.source is string && request.resource.data.source.size() <= 30)) &&
        (!request.resource.data.keys().hasAny(["name"]) || (request.resource.data.name is string && request.resource.data.name.size() <= 100)) &&
        (!request.resource.data.keys().hasAny(["displayName"]) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60)) &&
        (!request.resource.data.keys().hasAny(["studentId"]) || (request.resource.data.studentId is string && request.resource.data.studentId.size() <= 30)) &&
        (!request.resource.data.keys().hasAny(["department"]) || (request.resource.data.department is string && request.resource.data.department.size() <= 100)) &&
        (!request.resource.data.keys().hasAny(["school"]) || (request.resource.data.school is string && request.resource.data.school.size() <= 100)) &&
        (!request.resource.data.keys().hasAny(["phone"]) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30)) &&
        (!request.resource.data.keys().hasAny(["notificationPreferences"]) || (
          request.resource.data.notificationPreferences.keys().hasOnly(["announcements", "classReminders", "registrationUpdates"]) &&
          request.resource.data.notificationPreferences.announcements is bool &&
          request.resource.data.notificationPreferences.classReminders is bool &&
          request.resource.data.notificationPreferences.registrationUpdates is bool
        )) &&
        (!request.resource.data.keys().hasAny(["dismissedNotificationIds"]) || (request.resource.data.dismissedNotificationIds is list && request.resource.data.dismissedNotificationIds.size() <= 200)) &&
        (!request.resource.data.keys().hasAny(["readNotificationIds"]) || (request.resource.data.readNotificationIds is list && request.resource.data.readNotificationIds.size() <= 200)) &&
        (!request.resource.data.keys().hasAny(["privacyConsent"]) || request.resource.data.privacyConsent.accepted == true) &&
        (!request.resource.data.keys().hasAny(["createdAt"]) || request.resource.data.createdAt == request.time) &&
        (!request.resource.data.keys().hasAny(["updatedAt"]) || request.resource.data.updatedAt == request.time) &&
        (!request.resource.data.keys().hasAny(["lastLoginAt"]) || request.resource.data.lastLoginAt == request.time)
      );
      allow update: if isAdmin() || validOwnMembershipUpdate(userId) || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "displayName", "studentId", "department", "school", "phone", "applicationType", "notificationPreferences",
          "dismissedNotificationIds", "readNotificationIds", "source", "updatedAt", "lastLoginAt"
        ]) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["uid", "email", "privacyConsent", "createdAt", "approvedAt", "paidAt", "paymentConfirmedAt", "paymentConfirmedBy"]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["name"]) || (request.resource.data.name is string && request.resource.data.name.size() <= 100)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["displayName"]) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["studentId"]) || (request.resource.data.studentId is string && request.resource.data.studentId.size() <= 30)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["department"]) || (request.resource.data.department is string && request.resource.data.department.size() <= 100)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["school"]) || (request.resource.data.school is string && request.resource.data.school.size() <= 100)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["phone"]) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["notificationPreferences"]) || (
          request.resource.data.notificationPreferences.keys().hasOnly(["announcements", "classReminders", "registrationUpdates"]) &&
          request.resource.data.notificationPreferences.announcements is bool &&
          request.resource.data.notificationPreferences.classReminders is bool &&
          request.resource.data.notificationPreferences.registrationUpdates is bool
        )) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["dismissedNotificationIds"]) || (request.resource.data.dismissedNotificationIds is list && request.resource.data.dismissedNotificationIds.size() <= 200)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["readNotificationIds"]) || (request.resource.data.readNotificationIds is list && request.resource.data.readNotificationIds.size() <= 200)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["academicYear"]) || (request.resource.data.academicYear is string && request.resource.data.academicYear.matches('^[0-9]{2,3}$'))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["term"]) || request.resource.data.term in ["上學期", "下學期", "未設定"]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["applicationType"]) || request.resource.data.applicationType in ["club", "class"]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["membershipIntent"]) || request.resource.data.membershipIntent in ["join", "not_join"]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["paymentMethod"]) || request.resource.data.paymentMethod in ["cash", "transfer", "later", "none"]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["cashPaymentSlot"]) || (request.resource.data.cashPaymentSlot is string && request.resource.data.cashPaymentSlot.size() <= 50)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["transferAt"]) || (request.resource.data.transferAt is string && request.resource.data.transferAt.size() <= 40)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["transferLastFive"]) || (request.resource.data.transferLastFive is string && request.resource.data.transferLastFive.size() <= 5)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["source"]) || (request.resource.data.source is string && request.resource.data.source.size() <= 30)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["updatedAt"]) || request.resource.data.updatedAt == request.time) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastLoginAt"]) || request.resource.data.lastLoginAt == request.time) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["membershipStatus", "status", "paymentStatus", "paidAt", "approvedAt", "paymentConfirmedAt", "paymentConfirmedBy"]) ||
          (
            resource.data.membershipStatus != "formal_member" &&
            resource.data.status != "formal_member" &&
            resource.data.paymentStatus != "paid" &&
            request.resource.data.membershipStatus in ["not_applied", "pending_payment"] &&
            request.resource.data.status == request.resource.data.membershipStatus &&
            request.resource.data.paymentStatus == "unpaid" &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(["paidAt", "approvedAt", "paymentConfirmedAt", "paymentConfirmedBy"])
          )
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /applications/{applicationId} {
      allow create: if isAdmin() || validOwnClubApplicationWrite(applicationId);
      // The membership transaction reads this deterministic document before
      // creating it.  On a member's first application there is no resource
      // data (and therefore no email) to authorize the lookup with yet.
      allow get: if isAdmin() || (
        isSignedIn() && applicationId == "club-" + request.auth.uid
      ) || (
        isSignedIn() && resource.data.email == request.auth.token.email
      );
      allow list: if isAdmin() || (
        isSignedIn() && resource.data.email == request.auth.token.email
      );
      allow update: if isAdmin() || (
        validOwnClubApplicationWrite(applicationId) &&
        request.resource.data.submittedAt == resource.data.submittedAt
      );
      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.email == request.auth.token.email
      );
    }

    match /signupApprovals/{emailId} {
      allow get: if isAdmin() || (isSignedIn() && emailId == request.auth.token.email);
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && emailId == request.auth.token.email);
    }
    match /siteSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /membershipRegistrationStats/{periodId} {
      allow read: if true;
      allow create, update: if isAdmin() || validOwnMembershipStatsWrite(periodId);
      allow delete: if isAdmin();
    }

    match /classSessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Album URLs are kept outside the public class-session documents so only
    // registered, signed-in accounts can retrieve them.
    match /classAlbums/{sessionId} {
      allow read: if isAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid))
      );
      allow create, update, delete: if isAdmin();
    }

    match /classSessionSignups/{signupId} {
      // New signups are read inside a transaction before the document exists.
      // Authorize that lookup from the deterministic <sessionId>-<uid> path.
      allow get: if isAdmin() || (
        isSignedIn()
        && (
          signupId.matches('^.+-' + request.auth.uid + '$')
          || resource.data.userId == request.auth.uid
        )
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (
        isSignedIn()
        && signupId == request.resource.data.sessionId + "-" + request.auth.uid
        && validOwnSignupCreate(request.resource.data.sessionId)
      );
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.userId == request.auth.uid
        && validOwnSignupUpdate(resource.data.sessionId)
      );
      allow delete: if isAdmin() || (
        isSignedIn()
        && resource.data.userId == request.auth.uid
        && (
          !exists(classStatsPath(resource.data.sessionId)) ||
          getAfter(classStatsPath(resource.data.sessionId)).data.signupCount == get(classStatsPath(resource.data.sessionId)).data.signupCount - 1
          && getAfter(classStatsPath(resource.data.sessionId)).data.firstHalfCount
            == get(classStatsPath(resource.data.sessionId)).data.signupCount - 1
          && getAfter(classStatsPath(resource.data.sessionId)).data.secondHalfCount
            == get(classStatsPath(resource.data.sessionId)).data.signupCount - 1
        )
      );
    }

    match /classPublicRosters/{rosterId} {
      allow get, list: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
    }

    match /classSessionStats/{sessionId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.keys().hasOnly(["sessionId", "signupCount", "waitlistCount", "firstHalfCount", "secondHalfCount", "updatedAt"])
        && request.resource.data.sessionId == sessionId
        && request.resource.data.signupCount == 1
        && request.resource.data.firstHalfCount is int && request.resource.data.firstHalfCount >= 0
        && request.resource.data.secondHalfCount is int && request.resource.data.secondHalfCount >= 0
        && request.resource.data.get("waitlistCount", 0) == 0
        && request.resource.data.updatedAt == request.time
        && !exists(ownClassSignupPath(sessionId))
        && existsAfter(ownClassSignupPath(sessionId))
      );
      allow update: if isAdmin() || (
        isSignedIn()
        && request.resource.data.keys().hasOnly(["sessionId", "signupCount", "waitlistCount", "firstHalfCount", "secondHalfCount", "updatedAt"])
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.signupCount is int
        && request.resource.data.signupCount >= 0
        && request.resource.data.firstHalfCount is int && request.resource.data.firstHalfCount >= 0
        && request.resource.data.secondHalfCount is int && request.resource.data.secondHalfCount >= 0
        && request.resource.data.firstHalfCount == request.resource.data.signupCount
        && request.resource.data.secondHalfCount == request.resource.data.signupCount
        && request.resource.data.get("waitlistCount", 0) == 0
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.signupCount == resource.data.signupCount + 1
            && !exists(ownClassSignupPath(sessionId))
            && existsAfter(ownClassSignupPath(sessionId))) ||
          (request.resource.data.signupCount == resource.data.signupCount - 1
            && exists(ownClassSignupPath(sessionId))
            && !existsAfter(ownClassSignupPath(sessionId))) ||
          (request.resource.data.signupCount == resource.data.signupCount
            && exists(ownClassSignupPath(sessionId))
            && existsAfter(ownClassSignupPath(sessionId)))
        )
      );
      allow delete: if isAdmin();
    }

    match /registrationVerifications/{verificationId} {
      allow read, write: if false;
    }

    match /classAnnouncements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /faqEntries/{faqId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /faqQuestions/{questionId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(["question", "status", "createdAt", "updatedAt"])
        && request.resource.data.question is string
        && request.resource.data.question.size() >= 2
        && request.resource.data.question.size() <= 500
        && request.resource.data.question.matches('^[^<>]*$')
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /adminNotifications/{notificationId} {
      allow read, update, delete: if isAdmin();
      // Account deletion is completed by the signed-in client on Spark plans.
      // A user may create only one deterministic, tightly validated notice for
      // their own account immediately before Authentication is deleted.
      allow create: if isSignedIn()
        && notificationId == "account-deleted-" + request.auth.uid
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          "type", "title", "message", "userId", "email", "name", "createdAt"
        ])
        && request.resource.data.type == "account_deleted"
        && request.resource.data.title == "使用者已刪除帳號"
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow delete: if isSignedIn()
        && notificationId == "account-deleted-" + request.auth.uid
        && resource.data.userId == request.auth.uid;
    }

    match /memberNotifications/{notificationId} {
      allow get, list: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
